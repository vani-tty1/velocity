using Gtk 4.0;
using Adw 1;

template $VelocityWindow: Adw.ApplicationWindow {
  title: _("Velocity");
  default-width: 350;
  default-height: 720;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.ViewSwitcher header_switcher {
        policy: wide;
        stack: stack;
      };

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
    }

    content: Adw.ViewStack stack {
      Adw.ViewStackPage {
        name: "test";
        title: _("Test");
        icon-name: "speedometer-symbolic";
        child: Adw.Clamp {
          maximum-size: 480;
          tightening-threshold: 400;

          child: Box {
            orientation: vertical;
            spacing: 18;
            valign: center;
            margin-top: 12;
            margin-bottom: 24;
            margin-start: 24;
            margin-end: 24;

            Label server_label {
              label: _("Ready");
              ellipsize: end;
            }

            Overlay {
              halign: center;

              child: DrawingArea gauge {
                content-width: 280;
                content-height: 280;
                accessible-role: img;
              };

              [overlay]
              Box {
                orientation: vertical;
                halign: center;
                valign: center;
                spacing: 2;

                Label speed_label {
                  label: "0";
                  styles ["numeric"]
                }

                Label unit_label {
                  label: _("Mbit/s");
                  styles ["dim-label"]
                }
              }
            }

            Label phase_label {
              label: _("Press Start to measure your connection");
              wrap: true;
              justify: center;
              styles ["heading"]
            }

            Button start_button {
              label: _("Start");
              halign: center;
              clicked => $on_start_clicked() swapped;
              styles ["suggested-action", "pill"]
            }

            Grid {
              column-spacing: 12;
              row-spacing: 12;
              column-homogeneous: true;
              row-homogeneous: true;
              margin-top: 12;

              Box {
                layout { column: 0; row: 0; }
                orientation: vertical;
                styles ["card"]

                Label {
                  label: _("Download");
                  halign: start;
                  margin-top: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["caption-heading", "dim-label"]
                }

                Label download_value {
                  label: "—";
                  halign: start;
                  margin-bottom: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["title-3", "numeric"]
                }
              }

              Box {
                layout { column: 1; row: 0; }
                orientation: vertical;
                styles ["card"]

                Label {
                  label: _("Upload");
                  halign: start;
                  margin-top: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["caption-heading", "dim-label"]
                }

                Label upload_value {
                  label: "—";
                  halign: start;
                  margin-bottom: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["title-3", "numeric"]
                }
              }

              Box {
                layout { column: 0; row: 1; }
                orientation: vertical;
                styles ["card"]

                Label {
                  label: _("Ping");
                  halign: start;
                  margin-top: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["caption-heading", "dim-label"]
                }

                Label ping_value {
                  label: "—";
                  halign: start;
                  margin-bottom: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["title-3", "numeric"]
                }
              }

              Box {
                layout { column: 1; row: 1; }
                orientation: vertical;
                styles ["card"]

                Label {
                  label: _("Jitter");
                  halign: start;
                  margin-top: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["caption-heading", "dim-label"]
                }

                Label jitter_value {
                  label: "—";
                  halign: start;
                  margin-bottom: 12;
                  margin-start: 14;
                  margin-end: 14;
                  styles ["title-3", "numeric"]
                }
              }
            }
          };
        };
      }

      Adw.ViewStackPage {
        name: "results";
        title: _("Results");
        icon-name: "document-open-recent-symbolic";

        child: Stack history_stack {
          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "document-open-recent-symbolic";
              title: _("No Results Yet");
              description: _("Completed tests will appear here.");
            };
          }

          StackPage {
            name: "list";

            child: ScrolledWindow {
              child: Adw.Clamp {
                maximum-size: 480;
                tightening-threshold: 400;

                child: ListBox history_list {
                  selection-mode: none;
                  valign: start;
                  margin-top: 12;
                  margin-bottom: 24;
                  margin-start: 12;
                  margin-end: 12;
                  styles ["boxed-list"]
                };
              };
            };
          }
        };
      }
    };

    [bottom]
    Adw.ViewSwitcherBar switcher_bar {
      stack: stack;
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 450sp")

    setters {
      switcher_bar.reveal: true;
      header_switcher.visible: false;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Velocity");
      action: "app.about";
    }
  }
}
